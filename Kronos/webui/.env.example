# Kronos WebUI environment variables
# Copy this file to .env and fill in real values. Never commit .env to git.

# Flask / JWT secret key; must be a long random string in production.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_HEX_64_CHARS

# Password for the built-in "admin" account.
# Change before first run; min 12 characters recommended.
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Google Gemini API key for AI market analysis (POST /api/analyze).
# Get it at: https://aistudio.google.com/apikey
# Leave empty to run in mock mode (no Gemini calls will be made).
GEMINI_API_KEY=

# Comma-separated allowed frontend origins for Flask CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Kronos-base model configuration.
# Path to the shiyu-coder/Kronos repository root when the WebUI is run outside it.
KRONOS_REPO_PATH=
KRONOS_MODEL_ID=NeoQuasar/Kronos-base
KRONOS_TOKENIZER_ID=NeoQuasar/Kronos-Tokenizer-base
KRONOS_MAX_CONTEXT=512

# Keep false in production. Set true only for local smoke tests without torch/HF.
ALLOW_KRONOS_STUB=false

# Flask server settings.
# Use "development" to enable debug mode and auto-reload; "production" otherwise.
FLASK_ENV=production
PORT=7070
